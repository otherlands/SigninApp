{
  "name": "eright-signin-v3",
  "version": "4.0.1",
  "private": true,
  "description": "LAN staff and visitor sign-in with fire roll call, event-sourced attendance, off-site copies and a read-only register assistant. Node only, no npm dependencies.",
  "main": "server.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server.js",
    "test": "node --disable-warning=ExperimentalWarning --test \"test/**/*.test.js\"",
    "check-config": "node --disable-warning=ExperimentalWarning server.js --check-config",
    "ctl": "node --disable-warning=ExperimentalWarning bin/signinctl.js"
  },
  "license": "UNLICENSED",
  "bin": {
    "signinctl": "bin/signinctl.js"
  }
}