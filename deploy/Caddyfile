# eRIGHT Sign-In — the one reverse-proxy order. Caddy sits in front of the app (plain HTTP on 127.0.0.1:3000) for
# signin.eright.co.uk and decides, by where the request comes FROM, what may reach the app:
#
#   FROM THE OFFICE NETWORK (192.168.0.0/16 etc.)   everything, exactly as on http://192.168.101.102:3000
#   FROM THE INTERNET                               only the roll-call page, the "I'm SAFE" page, the files they load,
#                                                   and the four calls they make — every request marked X-Public: 1 so the
#                                                   app also refuses anything else and only accepts self-marks with a
#                                                   personal key. Everything else: 403, logged.
#
# Install with deploy/install-caddy.sh. Nothing here is active until that script is run.
#
# BEFORE THIS CAN WORK (verified 2026-10-19, none of it is in place yet):
#   1. Public DNS: signin.eright.co.uk does not exist. eright.co.uk is on GoDaddy nameservers (ns13/ns14.domaincontrol.com).
#      Create an A record -> the site's public address (46.37.62.121 as seen from the office on 2026-10-19; confirm it is
#      static) and forward TCP 80 + 443 on the UniFi gateway to this server. (Or the DNS-01 variant: build Caddy with
#      github.com/caddy-dns/godaddy and add `tls { dns godaddy {env.GODADDY_TOKEN} }` inside the site block.)
#   2. The LAN DNS record on the UniFi gateway (192.168.101.1) currently answers 192.168.101.168 for this name, and nothing
#      lives at .168. Point it at this server (192.168.101.102).
#   3. PUBLIC_URL=https://signin.eright.co.uk in /etc/eright-signin.env, then restart the service.

{
    # Logs go to journald via the caddy unit; one line per request on the public host is wanted for audit.
}

signin.eright.co.uk {
    encode zstd gzip
    log {
        output stderr
        format console
    }
    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
        X-Frame-Options DENY
        -Server
    }

    # ---- office network: full access, same as the LAN address ------------------------------------------------
    @office remote_ip private_ranges
    handle @office {
        reverse_proxy 127.0.0.1:3000 {
            header_up X-Forwarded-Proto https
            header_up -X-Public
            flush_interval -1
        }
    }

    # ---- internet: the allow-list ------------------------------------------------------------------------
    # Pages and the files they load (GET only)
    @public_get {
        method GET
        path /fire /rollcall /safe /fire.js /shared.js /style.css /favicon.svg /sw.js /manifest.webmanifest /api/fire /api/me /api/stream
    }
    # The one write: a person marking THEMSELVES safe (the app insists on via:self + a valid personal key)
    @public_post {
        method POST
        path /api/fire/mark
    }
    handle @public_get {
        reverse_proxy 127.0.0.1:3000 {
            header_up X-Forwarded-Proto https
            header_up X-Public 1
            flush_interval -1
        }
    }
    handle @public_post {
        request_body {
            max_size 16KB
        }
        reverse_proxy 127.0.0.1:3000 {
            header_up X-Forwarded-Proto https
            header_up X-Public 1
        }
    }

    # ---- everything else from the internet ---------------------------------------------------------------
    handle {
        respond "Not available from outside the office." 403
    }
}
