# /etc/systemd/system/eright-signin-mirror.service
# OPTIONAL read-only mirror on a SECOND box (different building / cloud VM). Serves /fire from the last
# roster the main server pushed. eRIGHT's primary off-site copy is SharePoint (SP_* vars on the main
# unit); use this only if you also want SAFE/MISSING ticks to work with the main site dark. /fire has
# no login, so do not expose this to the internet without a PIN or VPN in front.
[Unit]
Description=eRIGHT sign-in v3 (mirror)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=signin
WorkingDirectory=/opt/eright-signin
Environment=PORT=3000
Environment=REPLICA=1
Environment=TZ_NAME=Europe/London
# /etc/eright-signin-mirror.env must contain MIRROR_TOKEN (same value as the main server)
EnvironmentFile=/etc/eright-signin-mirror.env
ExecStart=/usr/bin/node --disable-warning=ExperimentalWarning server.js
Restart=always
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/eright-signin/data
PrivateTmp=true

[Install]
WantedBy=multi-user.target
